NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
ENABLE_QA_PASSWORD_LOGIN=false
ENABLE_QA_PASSWORD_LOGIN_IN_PRODUCTION=false

# Server only: required for Admin-managed Student/Teacher Auth creation and reset.
# It must belong to NEXT_PUBLIC_SUPABASE_URL; never use a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ALS_LIVE_POC_ENABLED=false
ALS_LIVE_CLASS_ENABLED=false
ALS_LIVE_RECORDING_ENABLED=false
ALS_ACADEMIC_TIME_ZONE=Asia/Dubai

# CLI/CI only. Keep these out of browser-exposed variables.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# Admissions, server only. Optional HMAC secret; defaults to service-role key.
ENQUIRY_RATE_LIMIT_SECRET=
# Default: signed HttpOnly browser identity (10/hour) plus durable phone limit
# (3/hour); unrelated browsers never share a fallback quota. Cookie deletion can
# reset the browser quota, but never the phone quota. No raw IP is stored.
# Optional only when ingress overwrites this header AND blocks direct-origin
# traffic. Supported: cf-connecting-ip or x-real-ip. Forwarded chains are rejected.
ENQUIRY_TRUSTED_IP_HEADER=
